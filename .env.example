# Database Configuration
# For Local Development
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=aventra_db

# For Hostinger (update with your credentials)
# DB_HOST=your-hostinger-host.com
# DB_USER=your_cpanel_user
# DB_PASS=your_password
# DB_NAME=your_database_name

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration (Hostinger mailbox)
# These override the Email settings stored in the database.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=name@prismadot.com
# SMTP_PASS=your-mailbox-password
# MAIL_FROM_EMAIL=name@prismadot.com
# MAIL_FROM_NAME=Aventra Booking
# MAIL_REPLY_TO=name@prismadot.com
